@@ -0,0 +1,228 @@
+/**
+ * Timer Source kind and plugin entry, exported as `./timer-watch`. It brings time into the domain, as waiting conditions
+ * belong to Sources: each occurrence of a schedule is the operator's standing request on its own Thread, and a wake request a
+ * worker files continues its open ticket at a time, when a file appears, or at a deadline.
+ */
+import type { Context } from '@deepseek-ai/cordis'
+import { existsSync } from 'node:fs'
+import { mkdir, readdir, writeFile } from 'node:fs/promises'
+import { dirname, join } from 'node:path'
+import { z } from 'zod'
+import { key, liveTicket, threadKey, type OutboundMessage, type ThreadRef, type Trigger } from '../core/index.ts'
+import { KV } from '../kv.ts'
+import { latestBetween, parseCron, validCron } from './cron.ts'
+import { health, sourceContext, type SourceContext } from './host.ts'
+import { REPLY_TITLES, replyBlock, replyMarker } from './inbox-note.ts'
+import type { SourceKind } from './kind.ts'
+import { appendOnce, compactStamp, fileUrl, inside, localStamp, moveInto, readJson } from './local-files.ts'
+import { pause } from './poll.ts'
+export const TIMER = 'timer'
+/** The actor of each schedule occurrence: the operator, who wrote the schedule in the settings, which only the panel saves. */
+export const SCHEDULE_ACTOR = 'operator'
+const Slug = z.string().regex(/^[a-z0-9][a-z0-9-]{0,39}$/)
+const absolute = z.string().trim().regex(/^(\/.*)?$/, 'An absolute path')
+const ScheduleSchema = z.object({
+  id: Slug,
+  cron: z.string().trim().refine(validCron, 'Five cron fields (minute hour day month weekday) or an alias such as @daily'),
+  business: z.string().trim().regex(/^([a-z0-9][a-z0-9-]*)?$/).default(''),
+  type: z.string().trim().regex(/^([a-z0-9-]{1,30})?$/).default(''),
+  text: z.string().trim().min(1).max(4000),
+  state: z.enum(['on', 'off']).default('on'),
+}).strict()
+const TimerConfigSchema = z.object({
+  schedules: z.array(ScheduleSchema).default([]),
+  wakeDir: absolute.default(''),
+  reportsDir: absolute.default(''),
+  pollSeconds: z.number().int().min(5).max(600).default(15),
+}).strict()
+export type TimerConfig = z.infer<typeof TimerConfigSchema>
+export type Schedule = TimerConfig['schedules'][number]
+/** A wake request: the open ticket to continue, and when: at a time, once a file exists, or at the latest at a deadline. */
+export const WakeSchema = z.object({
+  ticket: z.string().regex(/^[A-Za-z0-9_-]{1,80}$/),
+  at: z.iso.datetime({ offset: true }).optional(),
+  whenExists: z.string().regex(/^\//).optional(),
+  deadline: z.iso.datetime({ offset: true }).optional(),
+  note: z.string().trim().max(2000).default(''),
+  created: z.iso.datetime({ offset: true }),
+}).strict().refine(request => request.at !== undefined || request.whenExists !== undefined, 'A wake request names a time or a file')
+export type WakeRequest = z.infer<typeof WakeSchema>
+/** Why a wake request is due now, or undefined while it waits. */
+export function wakeReason(request: WakeRequest, now: Date, exists: (file: string) => boolean = existsSync): 'time' | 'file' | 'deadline' | undefined {
+  if (request.whenExists && exists(request.whenExists)) return 'file'
+  if (request.at && Date.parse(request.at) <= now.getTime()) return 'time'
+  if (request.deadline && Date.parse(request.deadline) <= now.getTime()) return 'deadline'
+  return undefined
+}
+const REASON_TEXT = { time: '约定的时间到了', file: '等待的文件出现了', deadline: '等待到了截止时间' } as const
+/** The log file of a schedule's reports: one Markdown note per schedule, by business, under `reportsDir`. */
+export const reportFile = (config: Pick<TimerConfig, 'reportsDir'>, schedule: Pick<Schedule, 'id' | 'business'>): string =>
+  config.reportsDir ? join(config.reportsDir, schedule.business || 'general', `${schedule.id}.md`) : ''
+/** The Trigger of one occurrence: on a Thread of its own, so each occurrence is a new request rather than a follow-up of the last. */
+export function scheduleTrigger(schedule: Schedule, occurrence: Date, config: Pick<TimerConfig, 'reportsDir'>): Trigger {
+  const at = occurrence.toISOString()
+  const thread: ThreadRef = { source: TIMER, id: `run/${schedule.id}/${compactStamp(occurrence)}` }
+  const report = reportFile(config, schedule)
+  return {
+    id: key(TIMER, 'schedule', schedule.id, at), source: TIMER, threads: [thread],
+    actor: { source: TIMER, id: SCHEDULE_ACTOR }, human: true, addressed: 'direct', at,
+    text: `${schedule.text}\n\n（定时任务 ${schedule.id}，计划时间 ${localStamp(occurrence)}）`,
+    ...report ? { channel: { source: TIMER, thread: threadKey(thread), address: { file: report, schedule: schedule.id, business: schedule.business } } } : {},
+    meta: { kind: 'schedule', schedule: schedule.id, business: schedule.business, occurrence: at, ...schedule.type ? { type: schedule.type } : {},
+      ...report ? { report } : {} },
+  }
+}
+/**
+ * The Trigger that continues a ticket. It is a machine's, so the gate admits it nowhere and it never resumes an ended ticket; it
+ * sits on the ticket's wake Thread and on the Thread the ticket started on, which the ticket follows, so it reaches the ticket's
+ * worker as an Input whether or not the worker followed the wake Thread.
+ */
+export function wakeTrigger(request: WakeRequest, name: string, reason: keyof typeof REASON_TEXT, origin: ThreadRef | undefined, now: Date): Trigger {
+  const thread: ThreadRef = { source: TIMER, id: `wake/${request.ticket}` }
+  return {
+    id: key(TIMER, 'wake', name, request.created), source: TIMER, threads: origin ? [thread, origin] : [thread],
+    actor: { source: TIMER, id: 'clock' }, human: false, at: now.toISOString(),
+    text: `定时唤醒（${REASON_TEXT[reason]}）：${request.note || '按 STATE.md 继续这张工单。'}`,
+    meta: { kind: 'wake', ticket: request.ticket, reason, ...request.whenExists ? { file: request.whenExists } : {} },
+  }
+}
+/** Appends a report of a schedule's ticket to the schedule's log; a routine's acknowledgement would only be noise there. */
+export async function sendTimer(_host: unknown, message: OutboundMessage, now = new Date()): Promise<'sent' | 'gone'> {
+  if (message.kind === 'acknowledgement') return 'sent'
+  const { file, schedule } = message.channel.address
+  if (!file) throw new Error('A timer report names no log file')
+  await mkdir(dirname(file), { recursive: true })
+  await writeFile(file, `# 定时任务 ${schedule ?? ''}\n`, { flag: 'wx' }).catch((error: unknown) => {
+    if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error
+  })
+  await appendOnce(file, replyMarker(message.id), replyBlock(message.id, REPLY_TITLES[message.kind], now, message.text))
+  return 'sent'
+}
+export const timerKind: SourceKind<TimerConfig> = {
+  kind: TIMER,
+  title: { zh: '定时', en: 'Timer' },
+  description: { zh: '定时任务按计划成为请求，每次一个新线程；执行器登记的唤醒在约定时间、等待的文件出现或截止时间到时继续它的工单。', en: 'Schedules become requests on their plan, each occurrence on a new Thread; a wake request a worker files continues its ticket at a time, when a file appears, or at a deadline.' },
+  schema: TimerConfigSchema,
+  fields: [
+    { key: 'schedules', type: 'rows', label: { zh: '定时任务', en: 'Schedules' }, columns: [
+      { key: 'id', type: 'text', label: { zh: '任务 id', en: 'Schedule id' }, pattern: '[a-z0-9][a-z0-9\\-]*' },
+      { key: 'cron', type: 'text', label: { zh: '时间（cron）', en: 'When (cron)' } },
+      { key: 'business', type: 'text', label: { zh: '业务', en: 'Business' }, optional: true },
+      { key: 'type', type: 'text', label: { zh: '类型', en: 'Type' }, optional: true },
+      { key: 'text', type: 'text', label: { zh: '要做的事', en: 'Request' } },
+      { key: 'state', type: 'select', label: { zh: '状态', en: 'State' }, options: [
+        { value: 'on', label: { zh: '开', en: 'On' } }, { value: 'off', label: { zh: '关', en: 'Off' } }] }] },
+    { key: 'wakeDir', type: 'text', label: { zh: '唤醒请求目录', en: 'Wake request folder' },
+      hint: { zh: '绝对路径。执行器用 hq wake 在这里写 JSON 唤醒请求；处理过的移进 .done。', en: 'An absolute path. Workers file JSON wake requests here with hq wake; handled ones move into .done.' } },
+    { key: 'reportsDir', type: 'text', label: { zh: '定时任务记录目录', en: 'Schedule report folder' },
+      hint: { zh: '绝对路径。每个定时任务一篇记录笔记，按业务分文件夹；工单的回复追加在里面。', en: 'An absolute path. One log note per schedule, in a folder per business; its tickets\' replies are appended to it.' } },
+    { key: 'pollSeconds', type: 'number', advanced: true, min: 5, max: 600, label: { zh: '检查间隔 / 秒', en: 'Check interval / seconds' } }],
+  health: [TIMER],
+  scope: ({ meta }) => ({ listened: true, observed: false, row: meta.kind === 'wake' ? 'wake' : 'schedules' }),
+  channel: {
+    allowed: (address, config) => inside(config.reportsDir, address.file ?? ''),
+    send: (host, message) => sendTimer(host, message),
+    link: address => ({ url: fileUrl(address.file ?? ''), label: { zh: `定时任务记录 ${address.schedule ?? ''}`.trim(), en: `Schedule log ${address.schedule ?? ''}`.trim() } }),
+  },
+  find: query => ({ threads: /^timer:\S+$/.test(query.trim()) ? [query.trim()] : [], terms: [] }),
+  policy: {
+    schema: z.object({ allowed: z.array(z.object({ id: z.string().regex(/^[A-Za-z0-9_.-]+$/), name: z.string().trim().max(100).optional() }).strict())
+      .default([]) }).strict(),
+    fields: [{ key: 'allowed', type: 'rows', label: { zh: '能发起工作的定时任务作者', en: 'Schedule authors who may originate work' },
+      hint: { zh: `定时任务都记在 ${SCHEDULE_ACTOR} 名下；名单里有它，定时任务才会成为明确的请求。`, en: `Schedules are recorded under ${SCHEDULE_ACTOR}; with it on the list, each occurrence is an explicit request.` },
+      columns: [{ key: 'id', type: 'text', label: { zh: 'id', en: 'id' } }, { key: 'name', type: 'text', label: { zh: '名字', en: 'Name' }, optional: true }] }],
+    explicit: { zh: '定时任务到了计划时间。', en: 'A schedule reaches its planned time.' },
+    rows: () => [
+      { id: 'schedules', label: { zh: '定时任务', en: 'Schedules' }, note: { zh: '每次都点名', en: 'Each occurrence addresses the agent' },
+        cells: { listedUnaddressed: false, unlistedAddressed: false, unlistedUnaddressed: false } },
+      { id: 'wake', label: { zh: '工单唤醒', en: 'Ticket wakes' }, note: { zh: '只送给它的工单', en: 'Reaches only its ticket' },
+        cells: { listedUnaddressed: false, unlistedAddressed: false, unlistedUnaddressed: false } }],
+  },
+  environment: {
+    variables: [
+      { key: 'DSH_SUPERAGENT_TIMER_SCHEDULE', description: { zh: '接下工单的定时任务 id；工单不是定时任务开的时为空', en: 'The schedule that started the ticket; empty when no schedule started it' } },
+      { key: 'DSH_SUPERAGENT_TIMER_BUSINESS', description: { zh: '定时任务写明的业务 id；没写或不是定时任务时为空', en: 'The business the schedule names; empty when none is named or no schedule started the ticket' } },
+      { key: 'DSH_SUPERAGENT_TIMER_TYPE', description: { zh: '定时任务写明的工作类型；没写时为空', en: 'The kind of work the schedule names; empty when none is named' } },
+      { key: 'DSH_SUPERAGENT_TIMER_REPORT', description: { zh: '定时任务的记录笔记，这张工单的回复追加在里面；没有时为空', en: 'The schedule\'s log note, which this ticket\'s replies are appended to; empty when there is none' } },
+    ],
+    values: ({ trigger }) => {
+      const text = (name: string): string => trigger?.source === TIMER && trigger.meta.kind === 'schedule' && typeof trigger.meta[name] === 'string' ? trigger.meta[name] : ''
+      return { DSH_SUPERAGENT_TIMER_SCHEDULE: text('schedule'), DSH_SUPERAGENT_TIMER_BUSINESS: text('business'), DSH_SUPERAGENT_TIMER_TYPE: text('type'),
+        DSH_SUPERAGENT_TIMER_REPORT: text('report') }
+    },
+  },
+}
+export const name = 'dsh-superagent-timer'
+export const inject = ['orchestrator']
+export function apply(ctx: Context): void {
+  ctx.effect(() => ctx.orchestrator.sources.register(timerKind), 'timer: source kind')
+  ctx.effect(() => {
+    const source = sourceContext(ctx.orchestrator, timerKind)
+    const controller = new AbortController()
+    // Unhandled rejections terminate the DSH process, so a failure escaping the loop is reported as source health instead.
+    const running = watch(source, controller.signal)
+      .catch((error: unknown) => { source.report(TIMER, { state: 'error', detail: String(error) }) })
+    return async () => { controller.abort(); await running }
+  })
+}
+async function watch(ctx: SourceContext, signal: AbortSignal): Promise<void> {
+  await ctx.ready
+  if (!ctx.configured()) { ctx.report(TIMER, health('paused', 'setupPending')); return }
+  let failures = 0
+  while (!signal.aborted) {
+    const config = ctx.config<TimerConfig>(TIMER)
+    const at = new Date()
+    if (!config) ctx.report(TIMER, health('paused', 'sourceOff'))
+    else {
+      try {
+        const due = await timerRound(ctx, config, at)
+        failures = 0
+        ctx.report(TIMER, { state: 'ready', at: at.toISOString(), detail: `${config.schedules.filter(item => item.state === 'on').length} schedules on, `
+          + `${due.started} started, ${due.waiting} wake requests waiting, ${due.woken} woken` })
+      } catch (error) {
+        failures += 1
+        if (!signal.aborted && failures >= 3) ctx.report(TIMER, health('error', 'pollFailures', { count: String(failures), error: String(error) }))
+      }
+    }
+    await pause((config?.pollSeconds ?? 15) * 1000, signal)
+  }
+}
+export interface TimerRound { started: number; waiting: number; woken: number }
+/**
+ * One check: starts each schedule whose occurrence passed since the last one it started, and wakes the tickets whose wake
+ * requests are due. A schedule seen for the first time starts counting from now, so adding one never runs it at once.
+ */
+export async function timerRound(ctx: SourceContext, config: TimerConfig, now: Date): Promise<TimerRound> {
+  const round: TimerRound = { started: 0, waiting: 0, woken: 0 }
+  for (const schedule of config.schedules) {
+    if (schedule.state === 'off') continue
+    const last = KV.timer.last(schedule.id)
+    const since = ctx.state.get(last)
+    if (!since) { ctx.state.set(last, now.toISOString()); continue }
+    const occurrence = latestBetween(parseCron(schedule.cron), new Date(since), now)
+    if (!occurrence) continue
+    if (await ctx.receive(scheduleTrigger(schedule, occurrence, config)) === 'stored') round.started += 1
+    ctx.state.set(last, occurrence.toISOString())
+  }
+  if (!config.wakeDir) return round
+  const names = await readdir(config.wakeDir).catch((error: unknown) => {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return []
+    throw error
+  })
+  for (const name of names.filter(item => item.endsWith('.json') && !item.startsWith('.')).sort()) {
+    const file = join(config.wakeDir, name)
+    const parsed = WakeSchema.safeParse(await readJson(file))
+    if (!parsed.success) { await moveInto(file, join(config.wakeDir, '.bad')); continue }
+    const request = parsed.data
+    const ticket = ctx.tickets.get(request.ticket)
+    // An ended or unknown ticket has nothing to continue; a machine's Trigger would not resume it anyway.
+    if (!ticket || !liveTicket(ticket)) { await moveInto(file, join(config.wakeDir, '.done')); continue }
+    const reason = wakeReason(request, now)
+    if (!reason) { round.waiting += 1; continue }
+    const origin = ctx.triggers.get(ticket.origin.triggerId)?.threads[0]
+    await ctx.receive(wakeTrigger(request, name, reason, origin, now))
+    await moveInto(file, join(config.wakeDir, '.done'))
+    round.woken += 1
+  }
+  return round
+}
