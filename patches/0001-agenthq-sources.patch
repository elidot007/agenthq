index 0000000..ba77a6b
--- /dev/null
+++ b/src/sources/cron.ts
@@ -0,0 +1,63 @@
+/**
+ * Five-field cron expressions (minute hour day-of-month month day-of-week) on the host's local clock, and their occurrences.
+ * Fields take `*`, numbers, ranges `a-b`, steps `*\/n` and `a-b/n`, and lists `a,b`; `@hourly`, `@daily`, `@weekly`,
+ * `@monthly` and `@yearly` name the usual ones. As in cron, when both day fields are restricted, a day matching either counts.
+ */
+export interface Cron { minutes: Set<number>; hours: Set<number>; days: Set<number>; months: Set<number>; weekdays: Set<number>
+  anyDay: boolean; anyWeekday: boolean }
+const ALIASES: Readonly<Record<string, string>> = { '@hourly': '0 * * * *', '@daily': '0 0 * * *', '@midnight': '0 0 * * *',
+  '@weekly': '0 0 * * 0', '@monthly': '0 0 1 * *', '@yearly': '0 0 1 1 *', '@annually': '0 0 1 1 *' }
+function field(text: string, min: number, max: number, label: string): Set<number> {
+  const values = new Set<number>()
+  for (const part of text.split(',')) {
+    const match = /^(\*|(\d+)(?:-(\d+))?)(?:\/(\d+))?$/.exec(part)
+    if (!match) throw new Error(`The ${label} field "${text}" is not a cron field`)
+    const from = match[1] === '*' ? min : Number(match[2]), to = match[1] === '*' ? max : match[3] === undefined ? (match[4] ? max : from) : Number(match[3])
+    const step = match[4] === undefined ? 1 : Number(match[4])
+    if (from < min || to > max || from > to || step < 1) throw new Error(`The ${label} field "${text}" leaves ${min}-${max}`)
+    for (let value = from; value <= to; value += step) values.add(value)
+  }
+  return values
+}
+/** Parses a cron expression. @throws when it is not five valid fields or a known alias. */
+export function parseCron(expression: string): Cron {
+  const fields = (ALIASES[expression.trim().toLowerCase()] ?? expression).trim().split(/\s+/)
+  if (fields.length !== 5) throw new Error(`"${expression}" is not five cron fields: minute hour day month weekday`)
+  const [minute, hour, day, month, weekday] = fields as [string, string, string, string, string]
+  const weekdays = field(weekday, 0, 7, 'weekday')
+  // 7 names Sunday too.
+  if (weekdays.delete(7)) weekdays.add(0)
+  return { minutes: field(minute, 0, 59, 'minute'), hours: field(hour, 0, 23, 'hour'), days: field(day, 1, 31, 'day'),
+    months: field(month, 1, 12, 'month'), weekdays, anyDay: day === '*', anyWeekday: weekday === '*' }
+}
+export const validCron = (expression: string): boolean => { try { parseCron(expression); return true } catch { return false } }
+function dayMatches(cron: Cron, at: Date): boolean {
+  const day = cron.days.has(at.getDate()), weekday = cron.weekdays.has(at.getDay())
+  if (cron.anyDay && cron.anyWeekday) return true
+  if (cron.anyDay) return weekday
+  if (cron.anyWeekday) return day
+  return day || weekday
+}
+/** The first occurrence strictly after `after`, within `limitDays`; undefined when none falls in that window, as for 31 February. */
+export function nextAfter(cron: Cron, after: Date, limitDays = 400): Date | undefined {
+  const at = new Date(after.getTime())
+  at.setSeconds(0, 0)
+  at.setMinutes(at.getMinutes() + 1)
+  const end = after.getTime() + limitDays * 86_400_000
+  while (at.getTime() <= end) {
+    if (!cron.months.has(at.getMonth() + 1)) { at.setMonth(at.getMonth() + 1, 1); at.setHours(0, 0, 0, 0); continue }
+    if (!dayMatches(cron, at)) { at.setDate(at.getDate() + 1); at.setHours(0, 0, 0, 0); continue }
+    if (!cron.hours.has(at.getHours())) { at.setHours(at.getHours() + 1, 0, 0, 0); continue }
+    if (!cron.minutes.has(at.getMinutes())) { at.setMinutes(at.getMinutes() + 1, 0, 0); continue }
+    return at
+  }
+  return undefined
+}
+/** The latest occurrence after `since` and at or before `now`, so a host that was down runs a missed occurrence once, not each of them. */
+export function latestBetween(cron: Cron, since: Date, now: Date): Date | undefined {
+  let latest: Date | undefined
+  for (let next = nextAfter(cron, since), steps = 0; next && next.getTime() <= now.getTime() && steps < 100_000; next = nextAfter(cron, next), steps++) {
+    latest = next
+  }
+  return latest
+}
