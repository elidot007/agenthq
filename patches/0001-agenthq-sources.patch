+    note(file, '# 竞品调研\n调研三家，周五前给结论。', 3)
+    expect(await scanInbox(h.ctx, h.config)).toMatchObject({ notes: 1, received: 0, settling: 1 })
+    utimesSync(file, new Date(Date.now() - 60_000), new Date(Date.now() - 60_000))
+    expect(await scanInbox(h.ctx, h.config)).toMatchObject({ notes: 1, received: 1, settling: 0 })
+    const [trigger] = noteTriggers(parseNote(readFileSync(file, 'utf8')), { business, file, path: '竞品.md', changed: 0 }, h.config)
+    expect(h.engine.candidate(trigger!.id)?.strength).toBe('explicit')
+    expect(h.store.threads.get('inbox:research/竞品')?.meta).toMatchObject({ label: '竞品调研' })
