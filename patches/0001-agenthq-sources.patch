+    const first = noteTriggers(parseNote(`做调研\n${replyBlock('m1', '回复', new Date(), '要哪几家？')}好\n${replyBlock('m2', '回复', new Date(), '还有吗？')}好\n`), place, { owner: 'alice' })
+    expect(first.map(trigger => trigger.text)).toEqual(['做调研', '好', '好'])
+    expect(new Set(first.map(trigger => trigger.id)).size).toBe(3)
+    expect(noteTriggers(parseNote(`做调研\n${replyBlock('m1', '回复', new Date(), '要哪几家？')}好\n`), place, { owner: 'alice' }).map(trigger => trigger.id))
+      .toEqual(first.slice(0, 2).map(trigger => trigger.id))
+    expect(noteTriggers(parseNote('做竞品调研'), place, { owner: 'alice' })[0]!.id).not.toBe(first[0]!.id)
+    expect(first[0]).toMatchObject({ source: 'inbox', threads: [{ source: 'inbox', id: 'research/a' }], actor: { source: 'inbox', id: 'alice' }, human: true,
+      addressed: 'direct', channel: { source: 'inbox', thread: 'inbox:research/a', address: { business: 'research', file: '/inbox/research/a.md' } },
+      meta: { business: 'research', file: '/inbox/research/a.md', path: 'a.md', type: 'research', title: 'a' } })
+  })
+})
+describe('the inbox Source', () => {
+  it('takes in a settled note as an explicit request, once, and leaves a note that is still being written for later', async () => {
