+import { mkdirSync, readFileSync, rmSync, utimesSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+import { threadKey, type OutboundMessage } from '../src/core/index.ts'
+import { KV } from '../src/kv.ts'
+import { inboxKind, noteTriggers, scanInbox, sendInbox, type InboxConfig } from '../src/sources/inbox.ts'
+import { parseNote, replyBlock } from '../src/sources/inbox-note.ts'
+import { inside, listFiles } from '../src/sources/local-files.ts'
+import { localHost } from './fixtures/local-sources.ts'
+const hosts: ReturnType<typeof localHost>[] = []
+afterEach(() => { for (const h of hosts.splice(0)) { h.store.close(); rmSync(h.dir, { recursive: true, force: true }) } })
+const business = { id: 'research', title: '调研', folder: '', type: 'research', repo: '' }
+function host(overrides: Partial<InboxConfig> = {}) {
+  const h = localHost([inboxKind], {})
+  const config: InboxConfig = { root: join(h.dir, 'inbox'), owner: 'alice', businesses: [business], settleSeconds: 15, pollSeconds: 5, ...overrides }
+  h.store.saveSettings({ ...h.store.settings(), sources: { inbox: { enabled: true, config } },
+    policy: { ...h.store.settings().policy, sources: { inbox: { allowed: [{ id: 'alice' }] } } } })
+  mkdirSync(join(config.root, 'research'), { recursive: true })
+  hosts.push(h)
+  return { ...h, config }
+}
+/** Writes a note and dates it `secondsAgo` in the past, so it counts as settled or as still being written. */
+function note(file: string, text: string, secondsAgo = 60): void {
+  mkdirSync(join(file, '..'), { recursive: true })
+  writeFileSync(file, text)
+  const at = new Date(Date.now() - secondsAgo * 1000)
+  utimesSync(file, at, at)
+}
+describe('an inbox note', () => {
+  it('splits into front matter, the passages a person wrote and the agent\'s replies', () => {
+    const parsed = parseNote(`---\ntype: code\nrepo: "/src/widgets"\ndraft: false\n---\n# 修复登录\n先看日志。\n\n---\n${replyBlock('m1', '已接单', new Date(), '收到，\n\n先复现。')}再补一句。\n`)
+    expect(parsed.head).toEqual({ type: 'code', repo: '/src/widgets', draft: 'false' })
+    expect(parsed.blocks.map(({ kind, text, index, id }) => ({ kind, text, index, ...id ? { id } : {} }))).toEqual([
+      { kind: 'person', text: '# 修复登录\n先看日志。\n\n---', index: 0 },
+      { kind: 'agent', text: expect.stringContaining('收到，\n\n先复现。'), index: 1, id: 'm1' },
