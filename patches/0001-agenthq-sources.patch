+import { existsSync, mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+import type { OutboundMessage, Trigger } from '../src/core/index.ts'
+import { KV } from '../src/kv.ts'
+import { latestBetween, nextAfter, parseCron, validCron } from '../src/sources/cron.ts'
+import { scheduleTrigger, sendTimer, timerKind, timerRound, wakeReason, type TimerConfig } from '../src/sources/timer.ts'
+import { localHost, openTicket } from './fixtures/local-sources.ts'
+const hosts: ReturnType<typeof localHost>[] = []
+afterEach(() => { for (const h of hosts.splice(0)) { h.store.close(); rmSync(h.dir, { recursive: true, force: true }) } })
+const local = (text: string): Date => new Date(text)
+describe('cron', () => {
+  it('finds the next occurrence of each field form on the local clock', () => {
+    expect(nextAfter(parseCron('0 8 * * *'), local('2026-11-01T07:59:30'))).toEqual(local('2026-11-01T08:00:00'))
+    expect(nextAfter(parseCron('0 8 * * *'), local('2026-11-01T08:00:00'))).toEqual(local('2026-11-02T08:00:00'))
+    expect(nextAfter(parseCron('*/15 9-10 * * *'), local('2026-11-01T10:46:00'))).toEqual(local('2026-11-02T09:00:00'))
+    expect(nextAfter(parseCron('30 18 * * 1,3,5'), local('2026-11-01T12:00:00'))).toEqual(local('2026-11-02T18:30:00'))
+    expect(nextAfter(parseCron('0 0 * * 7'), local('2026-11-02T00:00:00'))).toEqual(local('2026-11-08T00:00:00'))
+    // With both day fields restricted, either one matches, as in cron.
+    expect(nextAfter(parseCron('0 0 15 * 1'), local('2026-11-03T00:00:00'))).toEqual(local('2026-11-09T00:00:00'))
+    expect(nextAfter(parseCron('@daily'), local('2026-11-01T23:59:00'))).toEqual(local('2026-11-02T00:00:00'))
+    expect(nextAfter(parseCron('0 0 31 2 *'), local('2026-01-01T00:00:00'))).toBeUndefined()
+  })
+  it('refuses what is not five fields within range', () => {
+    for (const bad of ['0 8 * *', '60 8 * * *', '0 24 * * *', '0 8 * * 8', 'every day', '5-1 * * * *']) expect(validCron(bad)).toBe(false)
+    expect(validCron('5/20 * * * *')).toBe(true)
+  })
+  it('runs a missed stretch once, at its latest occurrence', () => {
+    expect(latestBetween(parseCron('0 * * * *'), local('2026-11-01T05:30:00'), local('2026-11-01T09:10:00'))).toEqual(local('2026-11-01T09:00:00'))
+    expect(latestBetween(parseCron('0 * * * *'), local('2026-11-01T09:00:00'), local('2026-11-01T09:59:00'))).toBeUndefined()
+  })
+})
+function host(overrides: Partial<TimerConfig> = {}) {
+  const h = localHost([timerKind], {})
+  const config: TimerConfig = { schedules: [{ id: 'daily-brief', cron: '0 8 * * *', business: 'research', type: 'research', text: '写今天的简报', state: 'on' }],
+    wakeDir: join(h.dir, 'wake'), reportsDir: join(h.dir, 'reports'), pollSeconds: 15, ...overrides }
+  h.store.saveSettings({ ...h.store.settings(), sources: { timer: { enabled: true, config } },
+    policy: { ...h.store.settings().policy, sources: { timer: { allowed: [{ id: 'operator' }] } } } })
+  hosts.push(h)
+  return { ...h, config }
+}
+describe('schedules', () => {
+  it('start counting when first seen, then make each occurrence an explicit request on a Thread of its own, once', async () => {
+    const h = host()
+    expect(await timerRound(h.ctx, h.config, local('2026-11-01T07:00:00'))).toMatchObject({ started: 0 })
+    expect(h.ctx.state.get(KV.timer.last('daily-brief'))).toBe(local('2026-11-01T07:00:00').toISOString())
+    expect(await timerRound(h.ctx, h.config, local('2026-11-01T08:00:20'))).toMatchObject({ started: 1 })
+    expect(await timerRound(h.ctx, h.config, local('2026-11-01T08:01:00'))).toMatchObject({ started: 0 })
+    const trigger = scheduleTrigger(h.config.schedules[0]!, local('2026-11-01T08:00:00'), h.config)
+    expect(h.engine.candidate(trigger.id)?.strength).toBe('explicit')
+    expect(trigger).toMatchObject({ human: true, addressed: 'direct', actor: { source: 'timer', id: 'operator' },
+      meta: { kind: 'schedule', schedule: 'daily-brief', business: 'research', type: 'research', report: join(h.dir, 'reports', 'research', 'daily-brief.md') } })
+    expect(trigger.threads[0]!.id).toMatch(/^run\/daily-brief\/20261101-0800$/)
+    expect(scheduleTrigger(h.config.schedules[0]!, local('2026-11-02T08:00:00'), h.config).threads[0]).not.toEqual(trigger.threads[0])
+  })
+  it('skip a schedule that is off', async () => {
+    const h = host()
+    const off = { ...h.config, schedules: [{ ...h.config.schedules[0]!, state: 'off' as const }] }
+    await timerRound(h.ctx, off, local('2026-11-01T07:00:00'))
+    expect(h.ctx.state.get(KV.timer.last('daily-brief'))).toBeUndefined()
+  })
+  it('write their tickets\' replies into the schedule\'s log, and leave the acknowledgement out', async () => {
+    const h = host()
+    const file = join(h.dir, 'reports', 'research', 'daily-brief.md')
+    const message = (id: string, kind: OutboundMessage['kind']): OutboundMessage => ({ id, kind, text: `${kind} text`,
+      channel: { source: 'timer', thread: 'timer:run/daily-brief/20261101-0800', address: { file, schedule: 'daily-brief', business: 'research' } } })
+    expect(await sendTimer(undefined, message('a1', 'acknowledgement'))).toBe('sent')
+    expect(existsSync(file)).toBe(false)
+    expect(await sendTimer(undefined, message('r1', 'reply'))).toBe('sent')
+    expect(await sendTimer(undefined, message('r1', 'reply'))).toBe('sent')
+    const text = readFileSync(file, 'utf8')
+    expect(text).toMatch(/^# 定时任务 daily-brief\n/)
+    expect(text.match(/reply text/g)).toHaveLength(1)
+    expect(timerKind.channel!.allowed!({ file }, h.config)).toBe(true)
+    expect(timerKind.channel!.allowed!({ file: '/tmp/elsewhere.md' }, h.config)).toBe(false)
+  })
+})
+describe('wake requests', () => {
+  const origin: Trigger = { id: 'origin', source: 'inbox', threads: [{ source: 'inbox', id: 'research/a' }], actor: { source: 'inbox', id: 'alice' },
+    human: true, addressed: 'direct', at: '2026-11-01T00:00:00.000Z', text: '调研', meta: { business: 'research' } }
+  const request = (name: string, body: Record<string, unknown>, dir: string) => {
+    mkdirSync(dir, { recursive: true })
+    writeFileSync(join(dir, name), JSON.stringify({ created: '2026-11-01T00:00:00.000Z', ...body }))
+  }
+  it('continue an open ticket through the Thread it started on once due, and wait until then', async () => {
+    const h = host({ schedules: [] })
+    openTicket(h.store, 't1', origin)
+    request('t1.1.json', { ticket: 't1', at: '2026-11-02T09:00:00.000Z', note: '继续第二天的检索' }, h.config.wakeDir)
+    expect(await timerRound(h.ctx, h.config, new Date('2026-11-02T08:59:00.000Z'))).toMatchObject({ waiting: 1, woken: 0 })
+    expect(await timerRound(h.ctx, h.config, new Date('2026-11-02T09:00:05.000Z'))).toMatchObject({ waiting: 0, woken: 1 })
+    const ticket = h.store.tickets.get('t1')!
+    const input = ticket.inputs.find(item => item.kind === 'trigger')
+    expect(input).toBeDefined()
+    const trigger = h.store.triggers.get((input as { triggerId: string }).triggerId)!
+    expect(trigger).toMatchObject({ human: false, threads: [{ source: 'timer', id: 'wake/t1' }, { source: 'inbox', id: 'research/a' }] })
+    expect(trigger.text).toContain('继续第二天的检索')
+    expect(readdirSync(join(h.config.wakeDir, '.done'))).toEqual(['t1.1.json'])
+    // The machine's Trigger reaches no Eval of its own: the gate admits it nowhere.
+    expect(h.assessor.request).not.toHaveBeenCalled()
+  })
+  it('drop a request of a ticket that ended or does not exist, and set aside one that is not a request', async () => {
+    const h = host({ schedules: [] })
+    request('gone.json', { ticket: 'missing', at: '2026-11-01T00:00:00.000Z' }, h.config.wakeDir)
+    writeFileSync(join(h.config.wakeDir, 'bad.json'), '{"ticket": 1}')
+    await timerRound(h.ctx, h.config, new Date('2026-11-02T00:00:00.000Z'))
+    expect(readdirSync(join(h.config.wakeDir, '.done'))).toEqual(['gone.json'])
+    expect(readdirSync(join(h.config.wakeDir, '.bad'))).toEqual(['bad.json'])
+  })
+  it('are due when their file appears, or at their deadline', () => {
+    const base = { ticket: 't1', note: '', created: '2026-11-01T00:00:00.000Z' }
+    const now = new Date('2026-11-01T12:00:00.000Z')
+    expect(wakeReason({ ...base, whenExists: '/done.flag' }, now, () => true)).toBe('file')
+    expect(wakeReason({ ...base, whenExists: '/done.flag', deadline: '2026-11-01T11:00:00.000Z' }, now, () => false)).toBe('deadline')
+    expect(wakeReason({ ...base, whenExists: '/done.flag', deadline: '2026-11-01T13:00:00.000Z' }, now, () => false)).toBeUndefined()
+  })
+})
