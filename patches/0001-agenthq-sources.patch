+  })
+  it('go only to a note inside the root, of a listed business', () => {
+    const h = host()
+    const allowed = inboxKind.channel!.allowed!
+    expect(allowed({ business: 'research', file: join(h.config.root, 'research', 'a.md') }, h.config)).toBe(true)
