+/** A Store, Engine and Source context for the local Sources' tests (inbox, timer, spool), with stand-in ports. */
+import { mkdtempSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { vi } from 'vitest'
+import { Engine, type Assessor, type Executor, type Ticket, type Trigger } from '../../src/core/index.ts'
+import { Store } from '../../src/app/store.ts'
+import { sourceContextOf, type SourceContextDeps } from '../../src/app/source-context.ts'
+import { Commands } from '../../src/infra/commands.ts'
+import { HealthBoard } from '../../src/infra/health.ts'
+import { SettingsSchema, settingsPolicy } from '../../src/policy.ts'
+import type { SourceKind } from '../../src/sources/kind.ts'
+import { SourceRegistry } from '../../src/sources/registry.ts'
+import { testDeployment } from './deployment.ts'
+/** Builds the parts with `settings` saved, registers `kinds`, and returns a context for the first kind. */
+export function localHost(kinds: SourceKind[], settings: Record<string, unknown>) {
+  const dir = mkdtempSync(join(tmpdir(), 'local-sources-'))
+  const store = new Store(join(dir, 'db.sqlite'))
+  store.saveSettings(SettingsSchema.parse(settings))
+  const board = new HealthBoard()
+  const sources = new SourceRegistry(() => store.settings(), board)
+  for (const kind of kinds) sources.register(kind)
+  const assessor: Assessor = { request: vi.fn(async () => {}) }
+  const executor: Executor = { start: vi.fn(async () => {}), deliver: vi.fn(async () => {}), stop: vi.fn(async () => {}) }
+  const engine = new Engine({ repo: store, scope: sources, policy: () => settingsPolicy(store.settings(), sources), assessor, executor,
+    outbox: { send: () => {}, status: () => undefined, withdraw: () => {} } })
+  const commands = new Commands(() => testDeployment(), {}, new AbortController().signal)
+  const receive = vi.fn(async (trigger: Trigger) => { const result = engine.receive(trigger); engine.evaluateDue(); return result })
+  const deps: SourceContextDeps = { store, engine, outbox: { send: message => { store.receipts.add(message) } }, commands, sources,
+    deployment: testDeployment(), ready: Promise.resolve(), configured: () => true, receive }
+  const ctx = sourceContextOf(deps, kinds[0]!)
+  return { dir, store, engine, sources, receive, executor, assessor, ctx, health: board.all }
+}
+/** An open ticket that started from `origin`, saved with a Subscription to that Trigger's first Thread. */
+export function openTicket(store: Store, id: string, origin: Trigger): Ticket {
+  const ticket: Ticket = { id, title: id, decisionId: `d-${id}`, mandate: { strength: 'explicit', policyVersion: '',
+    basis: { source: origin.source, scope: origin.meta, via: 'addressed', addressed: 'direct' },
+    actor: origin.actor, scope: '' }, channels: origin.channel ? [origin.channel] : [], assignments: [], inputs: [], undelivered: [],
+    createdAt: origin.at, updatedAt: origin.at, origin: { triggerId: origin.id, triggerIds: [origin.id] } }
+  store.atomic(() => {
+    store.triggers.save(origin)
+    store.tickets.save(ticket)
+    const ref = origin.threads[0]!
+    store.threads.save({ key: `${ref.source}:${ref.id}`, ref, createdAt: origin.at, subscriptions: [id], correlated: [], pending: [], meta: {} })
+  })
+  return ticket
+}
