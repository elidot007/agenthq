@@ -0,0 +1,78 @@
+/** File helpers the local Sources (inbox, timer, spool) share: listing a folder, once-only appends, moves, and local timestamps. */
+import { appendFile, mkdir, readdir, readFile, rename, stat } from 'node:fs/promises'
+import { basename, extname, isAbsolute, join, relative, resolve, sep } from 'node:path'
+/** True for a name the local Sources leave alone: hidden (`.`) or reserved for their own records (`_`), such as `_done`. */
+export const reserved = (name: string): boolean => name.startsWith('.') || name.startsWith('_')
+/**
+ * Files under `root` whose names end with `extension`, as paths relative to it, oldest first by name; folders and files whose
+ * names start with `.` or `_` are skipped at every level. Stops after `limit` files.
+ * @throws the read error of `root` itself, such as ENOENT for a folder that does not exist yet.
+ */
+export async function listFiles(root: string, extension: string, limit = 5000): Promise<string[]> {
+  const found: string[] = []
+  const walk = async (dir: string): Promise<void> => {
+    const entries = await readdir(dir, { withFileTypes: true }).catch((error: unknown) => {
+      if (dir === root) throw error
+      // A subfolder removed during the walk holds nothing to read.
+      return []
+    })
+    for (const entry of entries.sort((a, b) => a.name.localeCompare(b.name))) {
+      if (found.length >= limit) return
+      if (reserved(entry.name)) continue
+      const path = join(dir, entry.name)
+      if (entry.isDirectory()) await walk(path)
+      else if (entry.isFile() && extname(entry.name).toLowerCase() === extension) found.push(relative(root, path))
+    }
+  }
+  await walk(root)
+  return found
+}
+/** True when `path` is absolute and lies inside `root` once `..` is resolved, so an address names no file outside a Source's folder. */
+export function inside(root: string, path: string): boolean {
+  if (!root || !isAbsolute(path)) return false
+  const rest = relative(resolve(root), resolve(path))
+  return rest !== '' && !rest.startsWith('..') && !isAbsolute(rest) && !rest.split(sep).includes('..')
+}
+/**
+ * Appends `text` to `file` once: a file that already holds `marker` is left as it is, so a retried send writes nothing twice.
+ * A file that does not end with a line break gets one first.
+ */
+export async function appendOnce(file: string, marker: string, text: string): Promise<'appended' | 'present' | 'missing'> {
+  let current: string
+  try { current = await readFile(file, 'utf8') } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return 'missing'
+    throw error
+  }
+  if (current.includes(marker)) return 'present'
+  await appendFile(file, `${current === '' || current.endsWith('\n') ? '' : '\n'}${text}`)
+  return 'appended'
+}
+/** Moves `file` into `dir`, created when missing, keeping its name; a name already taken there gets a numeric suffix. */
+export async function moveInto(file: string, dir: string): Promise<string> {
+  await mkdir(dir, { recursive: true })
+  const name = basename(file), extension = extname(name), stem = name.slice(0, name.length - extension.length)
+  for (let attempt = 0; ; attempt++) {
+    const target = join(dir, attempt ? `${stem}.${attempt}${extension}` : name)
+    const taken = await stat(target).then(() => true, () => false)
+    if (!taken) { await rename(file, target); return target }
+  }
+}
+/** The JSON value a file holds, or undefined when it cannot be read or is not JSON, so one bad file never fails a whole round. */
+export async function readJson(file: string): Promise<unknown> {
+  try { return JSON.parse(await readFile(file, 'utf8')) as unknown } catch { return undefined }
+}
+/** Milliseconds since `file` last changed, or undefined when it does not exist. */
+export async function age(file: string, now = Date.now()): Promise<number | undefined> {
+  return stat(file).then(info => now - info.mtimeMs, () => undefined)
+}
+const pad = (value: number): string => String(value).padStart(2, '0')
+/** A time as the host's local clock shows it, `YYYY-MM-DD HH:mm`, for text people read. */
+export function localStamp(at: Date): string {
+  return `${at.getFullYear()}-${pad(at.getMonth() + 1)}-${pad(at.getDate())} ${pad(at.getHours())}:${pad(at.getMinutes())}`
+}
+/** A time as a compact local name part, `YYYYMMDD-HHmm`, for ids and file names. */
+export function compactStamp(at: Date): string {
+  return `${at.getFullYear()}${pad(at.getMonth() + 1)}${pad(at.getDate())}-${pad(at.getHours())}${pad(at.getMinutes())}`
+}
+/** A `file://` address of an absolute path, for links people open. */
+export const fileUrl = (path: string): string => path ? `file://${encodeURI(path)}` : ''
