+import { localHost } from './fixtures/local-sources.ts'
+const hosts: ReturnType<typeof localHost>[] = []
+afterEach(() => { for (const h of hosts.splice(0)) { h.store.close(); rmSync(h.dir, { recursive: true, force: true }) } })
+function host() {
+  const h = localHost([spoolKind], {})
+  const config: SpoolConfig = { inDir: join(h.dir, 'in'), outDir: join(h.dir, 'out'), pollSeconds: 5,
+    senders: [{ id: 'dsbot', kind: 'person', business: 'general' }, { id: 'monitor', kind: 'bot', business: 'ops' }] }
+  h.store.saveSettings({ ...h.store.settings(), sources: { spool: { enabled: true, config } },
+    policy: { ...h.store.settings().policy, sources: { spool: { allowed: [{ id: 'dsbot' }] } } } })
+  mkdirSync(config.inDir, { recursive: true })
+  hosts.push(h)
+  return { ...h, config }
+}
+const drop = (dir: string, name: string, body: unknown): void => { writeFileSync(join(dir, name), typeof body === 'string' ? body : JSON.stringify(body)) }
+describe('the spool Source', () => {
+  it('takes a relayed request as explicit, filters an unlisted sender, sets aside what is not a request, and moves every file it read', async () => {
+    const h = host()
+    drop(h.config.inDir, 'a.json', { id: 'm1', sender: 'dsbot', conversation: 'chief', text: '整理本周的周报', business: 'content' })
+    drop(h.config.inDir, 'b.json', { id: 'm2', sender: 'stranger', text: '帮我做点事' })
+    drop(h.config.inDir, 'c.json', '{not json')
+    expect(await readSpool(h.ctx, h.config, new Date())).toEqual({ received: 1, unreadable: 1 })
+    const relayed = spoolTrigger(SpoolMessageSchema.parse({ id: 'm1', sender: 'dsbot', conversation: 'chief', text: '整理本周的周报', business: 'content' }),
+      { kind: 'person', business: 'general' }, h.config.outDir, new Date())
+    expect(h.engine.candidate(relayed.id)?.strength).toBe('explicit')
+    expect(relayed).toMatchObject({ human: true, addressed: 'direct', threads: [{ source: 'spool', id: 'chief/m1' }],
+      channel: { address: { conversation: 'chief', dir: join(h.config.outDir, 'chief') } }, meta: { business: 'content', sender: 'dsbot' } })
+    expect(readdirSync(join(h.config.inDir, '.done')).sort()).toEqual(['a.json', 'b.json'])
+    expect(readdirSync(join(h.config.inDir, '.bad'))).toEqual(['c.json'])
