+    expect(inboxKind.scope!({ meta: { business: 'research' } }, h.config)).toEqual({ listened: true, observed: false, row: 'research' })
+    expect(inboxKind.scope!({ meta: { business: 'research' } }, { ...h.config, root: '' })).toEqual({ listened: false, reason: 'inbox_unconfigured' })
+  })
+  it('names the note, its business, type and repository to the Executor', () => {
+    const h = host()
+    const [trigger] = noteTriggers(parseNote('---\nrepo: /src/app\n---\n改一下'), { business, file: '/inbox/research/x.md', path: 'x.md', changed: 0 }, h.config)
