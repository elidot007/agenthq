index 0000000..18bba18
--- /dev/null
+++ b/src/sources/inbox.ts
@@ -0,0 +1,232 @@
+/**
+ * Inbox Source kind and plugin entry, exported as `./inbox-watch`: Markdown notes in one folder per business. Each note is a
+ * Thread, each passage its author writes there a Trigger, and the agent's messages are callouts appended to the same note.
+ */
+import type { Context } from '@deepseek-ai/cordis'
+import { readFile, stat } from 'node:fs/promises'
+import { basename, join } from 'node:path'
+import { z } from 'zod'
+import { key, threadKey, type OutboundMessage, type ThreadRef, type Trigger } from '../core/index.ts'
+import { KV } from '../kv.ts'
+import { health, sourceContext, type SourceContext } from './host.ts'
+import { noteTitle, parseNote, REPLY_TITLES, replyBlock, replyMarker, yes, type Note } from './inbox-note.ts'
+import type { ContextMessage, SourceKind } from './kind.ts'
+import { appendOnce, fileUrl, inside, listFiles } from './local-files.ts'
+import { pause } from './poll.ts'
+export const INBOX = 'inbox'
+/** A reply waits while its note changed this recently, so it does not land in the middle of what a person is typing. */
+const QUIET_MS = 3000
+const folderPath = z.string().trim().refine(value => !value.startsWith('/') && !value.split('/').some(part => part === '..' || part === '.'),
+  'A folder inside the inbox root')
+const Slug = z.string().regex(/^[a-z0-9][a-z0-9-]{0,39}$/)
+const BusinessSchema = z.object({
+  id: Slug,
+  title: z.string().trim().max(60).default(''),
+  folder: folderPath.default(''),
+  type: z.string().trim().regex(/^([a-z0-9-]{1,30})?$/).default(''),
+  repo: z.string().trim().regex(/^(\/.*)?$/, 'An absolute path').default(''),
+}).strict()
+const InboxConfigSchema = z.object({
+  root: z.string().trim().regex(/^(\/.*)?$/, 'An absolute path').default(''),
+  owner: z.string().trim().regex(/^[A-Za-z0-9_.-]{1,40}$/).default('owner'),
+  businesses: z.array(BusinessSchema).default([]),
+  settleSeconds: z.number().int().min(0).max(600).default(15),
+  pollSeconds: z.number().int().min(2).max(600).default(5),
+}).strict()
+export type InboxConfig = z.infer<typeof InboxConfigSchema>
+export type InboxBusiness = InboxConfig['businesses'][number]
+/** The folder of a business, under the root. */
+export const businessFolder = (config: InboxConfig, business: InboxBusiness): string => join(config.root, business.folder || business.id)
+/** Where a note sits: its business, its absolute path, its path inside the business folder, and when it last changed. */
+export interface NotePlace { business: InboxBusiness; file: string; path: string; changed: number }
+/**
+ * The Triggers of a note: one per passage its author wrote. A passage's id derives from its text and how many identical
+ * passages come before it, so a re-read finds the same ids, an edited passage arrives as a new Trigger, and two equal short
+ * answers stay two.
+ */
+export function noteTriggers(note: Note, place: NotePlace, config: Pick<InboxConfig, 'owner'>): Trigger[] {
+  const stem = place.path.replace(/\.md$/i, '')
+  const thread: ThreadRef = { source: INBOX, id: `${place.business.id}/${stem}` }
+  const type = note.head.type || place.business.type
+  const repo = note.head.repo || place.business.repo
+  const title = noteTitle(note, basename(stem))
+  const seen = new Map<string, number>()
+  return note.blocks.filter(block => block.kind === 'person').map(block => {
+    const repeat = seen.get(block.text) ?? 0
+    seen.set(block.text, repeat + 1)
+    return {
+      id: key(INBOX, thread.id, block.text, String(repeat)),
+      source: INBOX, threads: [thread],
+      actor: { source: INBOX, id: config.owner }, human: true, addressed: 'direct' as const,
+      at: new Date(place.changed + block.index).toISOString(),
+      text: block.text,
+      channel: { source: INBOX, thread: threadKey(thread), address: { business: place.business.id, file: place.file, name: title } },
+      url: fileUrl(place.file),
+      meta: { business: place.business.id, file: place.file, path: place.path, index: block.index, title,
+        ...type ? { type } : {}, ...repo ? { repo } : {} },
+    }
+  })
+}
+/** Appends an Outbox message to its note as a callout, once; a note that no longer exists can never receive it. */
+export async function sendInbox(_host: unknown, message: OutboundMessage, now = Date.now()): Promise<'sent' | 'gone'> {
+  const file = message.channel.address.file
+  if (!file) throw new Error('An inbox reply names no note')
+  const changed = await stat(file).then(info => info.mtimeMs, () => undefined)
+  if (changed === undefined) return 'gone'
+  if (now - changed < QUIET_MS) throw new Error('The note changed a moment ago; the reply waits until it is quiet')
+  const done = await appendOnce(file, replyMarker(message.id), replyBlock(message.id, REPLY_TITLES[message.kind], new Date(now), message.text))
+  return done === 'missing' ? 'gone' : 'sent'
+}
+/** A note's blocks as the messages an assessment reads, in document order; the agent's replies count as a bot's. */
+export function noteMessages(note: Note, owner: string, at: string): ContextMessage[] {
+  return note.blocks.map(block => block.kind === 'person'
+    ? { id: `p${block.index}`, from: owner, at, text: block.text }
+    : { id: `a${block.index}`, from: 'agent', at, text: block.text, bot: true as const })
+}
+export const inboxKind: SourceKind<InboxConfig> = {
+  kind: INBOX,
+  title: { zh: '收件箱', en: 'Inbox' },
+  description: { zh: '每个业务一个文件夹的 Markdown 笔记：一篇笔记是一个线程，作者写的每一段是一条触发，智能体的消息追加在同一篇笔记末尾。', en: 'Markdown notes in one folder per business: a note is a Thread, each passage its author writes a Trigger, and the agent\'s messages are appended to the same note.' },
+  schema: InboxConfigSchema,
+  fields: [
+    { key: 'root', type: 'text', label: { zh: '收件箱根目录', en: 'Inbox root' },
+      hint: { zh: '绝对路径。每个业务在它下面有一个文件夹；名字以 _ 或 . 开头的文件夹和文件不读，例如 _done、_routines。', en: 'An absolute path. Each business has a folder under it; folders and files whose names start with _ or . are not read, such as _done and _routines.' } },
+    { key: 'owner', type: 'text', label: { zh: '笔记作者', en: 'Note author' },
+      hint: { zh: '笔记里人写的段落都记在这个 id 名下；策略的名单里写同一个 id，它写的每段才是明确的请求。', en: 'Passages people write in the notes are recorded under this id; list the same id in the Policy so each passage is an explicit request.' } },
+    { key: 'businesses', type: 'rows', label: { zh: '业务', en: 'Businesses' }, columns: [
+      { key: 'id', type: 'text', label: { zh: '业务 id', en: 'Business id' }, pattern: '[a-z0-9][a-z0-9\\-]*' },
+      { key: 'title', type: 'text', label: { zh: '名称', en: 'Title' }, optional: true },
+      { key: 'folder', type: 'text', label: { zh: '文件夹', en: 'Folder' }, optional: true },
+      { key: 'type', type: 'text', label: { zh: '默认类型', en: 'Default type' }, optional: true },
+      { key: 'repo', type: 'text', label: { zh: '默认仓库', en: 'Default repository' }, optional: true }] },
+    { key: 'settleSeconds', type: 'number', advanced: true, min: 0, max: 600, label: { zh: '笔记静止多少秒后再读', en: 'Seconds a note stays unchanged before it is read' },
+      hint: { zh: '编辑器边写边保存；笔记在这段时间里没有再变，才把新写的段落当作写完。', en: 'Editors save while a person types; a passage counts as written once the note stays unchanged this long.' } },
+    { key: 'pollSeconds', type: 'number', advanced: true, min: 2, max: 600, label: { zh: '轮询间隔 / 秒', en: 'Polling interval / seconds' } }],
+  health: [INBOX],
+  scope: ({ meta }, config) => {
+    if (!config.root) return { listened: false, reason: 'inbox_unconfigured' }
+    const business = config.businesses.find(item => item.id === meta.business)
+    return business ? { listened: true, observed: false, row: business.id } : { listened: false, reason: 'business_not_listed' }
+  },
+  channel: {
+    allowed: (address, config) => config.businesses.some(item => item.id === address.business) && inside(config.root, address.file ?? ''),
+    send: (host, message) => sendInbox(host, message),
+    link: address => ({ url: fileUrl(address.file ?? ''), label: { zh: `收件箱笔记 ${address.name ?? ''}`.trim(), en: `Inbox note ${address.name ?? ''}`.trim() } }),
+  },
+  threadContext: {
+    messageId: trigger => `p${String(trigger.meta.index ?? 0)}`,
+    read: async (_commands, trigger, part, _cursor, config) => {
+      const note = parseNote(await readFile(String(trigger.meta.file ?? ''), 'utf8'))
+      const all = noteMessages(note, config.owner, trigger.at)
+      const own = all.findIndex(message => message.id === `p${String(trigger.meta.index ?? 0)}`)
+      const messages = part === 'root' ? all.slice(0, 1) : part === 'parent' ? own > 0 ? [all[own - 1]!] : [] : all
+      return { messages, body: { messages } }
+    },
+  },
+  find: query => ({ threads: /^inbox:\S+$/.test(query.trim()) ? [query.trim()] : [], terms: [] }),
+  policy: {
+    schema: z.object({ allowed: z.array(z.object({ id: z.string().regex(/^[A-Za-z0-9_.-]+$/), name: z.string().trim().max(100).optional() }).strict())
+      .default([]) }).strict(),
+    fields: [{ key: 'allowed', type: 'rows', label: { zh: '能发起工作的笔记作者', en: 'Note authors who may originate work' }, columns: [
+      { key: 'id', type: 'text', label: { zh: '作者 id', en: 'Author id' } },
+      { key: 'name', type: 'text', label: { zh: '名字', en: 'Name' }, optional: true }] }],
+    explicit: { zh: '名单里的作者在业务文件夹里写下一篇笔记，或在笔记里补写一段。', en: 'An author on the list writes a note in a business folder, or adds a passage to one.' },
+    rows: stored => {
+      const config = InboxConfigSchema.safeParse(stored)
+      return (config.success ? config.data.businesses : []).map(business => ({ id: business.id, label: business.title || business.id,
+        note: { zh: '每段都点名', en: 'Every passage addresses the agent' },
+        cells: { listedUnaddressed: false, unlistedAddressed: true, unlistedUnaddressed: false } }))
+    },
+  },
+  environment: {
+    variables: [
+      { key: 'DSH_SUPERAGENT_INBOX_BUSINESS', description: { zh: '接下工单的收件箱业务 id；工单不是从收件箱来的时为空', en: 'The inbox business that started the ticket; empty when it did not start in the inbox' } },
+      { key: 'DSH_SUPERAGENT_INBOX_NOTE', description: { zh: '接下工单的笔记的绝对路径；这张工单的消息都追加在它末尾', en: 'Absolute path of the note that started the ticket; the ticket\'s messages are appended to it' } },
+      { key: 'DSH_SUPERAGENT_INBOX_TYPE', description: { zh: '笔记或业务写明的工作类型，例如 research、code；没写时为空', en: 'The kind of work the note or its business names, such as research or code; empty when none is named' } },
+      { key: 'DSH_SUPERAGENT_INBOX_REPO', description: { zh: '笔记或业务写明的本地仓库绝对路径；没写时为空', en: 'Absolute path of the local repository the note or its business names; empty when none is named' } },
+    ],
+    values: ({ trigger }) => {
+      const text = (name: string): string => trigger?.source === INBOX && typeof trigger.meta[name] === 'string' ? trigger.meta[name] : ''
+      return { DSH_SUPERAGENT_INBOX_BUSINESS: text('business'), DSH_SUPERAGENT_INBOX_NOTE: text('file'), DSH_SUPERAGENT_INBOX_TYPE: text('type'),
+        DSH_SUPERAGENT_INBOX_REPO: text('repo') }
+    },
+  },
+}
+export const name = 'dsh-superagent-inbox'
+export const inject = ['orchestrator']
+export function apply(ctx: Context): void {
+  ctx.effect(() => ctx.orchestrator.sources.register(inboxKind), 'inbox: source kind')
+  ctx.effect(() => {
+    const source = sourceContext(ctx.orchestrator, inboxKind)
+    const controller = new AbortController()
+    // Unhandled rejections terminate the DSH process, so a failure escaping the polling loop is reported as source health instead.
+    const running = watch(source, controller.signal)
+      .catch((error: unknown) => { source.report(INBOX, { state: 'error', detail: String(error) }) })
+    return async () => { controller.abort(); await running }
+  })
+}
+async function watch(ctx: SourceContext, signal: AbortSignal): Promise<void> {
+  await ctx.ready
+  if (!ctx.configured()) { ctx.report(INBOX, health('paused', 'setupPending')); return }
+  let failures = 0
+  while (!signal.aborted) {
+    const config = ctx.config<InboxConfig>(INBOX)
+    const at = new Date().toISOString()
+    if (!config) ctx.report(INBOX, health('paused', 'sourceOff'))
+    else if (!config.root || !config.businesses.length) ctx.report(INBOX, { state: 'paused', detail: 'No inbox root or business is set', at })
+    else {
+      try {
+        const round = await scanInbox(ctx, config, signal)
+        failures = 0
+        ctx.report(INBOX, { state: 'ready', at, detail: `${round.notes} notes, ${round.received} new passages`
+          + `${round.settling ? `, ${round.settling} being written` : ''}${round.missing ? `, ${round.missing} business folders missing` : ''}` })
+      } catch (error) {
+        failures += 1
+        if (!signal.aborted && failures >= 3) ctx.report(INBOX, health('error', 'pollFailures', { count: String(failures), error: String(error) }))
+      }
+    }
+    await pause((config?.pollSeconds ?? 5) * 1000, signal)
+  }
+}
+export interface InboxRound { notes: number; received: number; settling: number; missing: number }
+/**
+ * Reads every changed, settled note of every business and hands its passages to the Engine; a note is remembered by its
+ * change time and size, so an unchanged note is not read again. A note marked `draft: true` waits until the mark goes.
+ */
+export async function scanInbox(ctx: SourceContext, config: InboxConfig, signal?: AbortSignal, now = Date.now()): Promise<InboxRound> {
+  const round: InboxRound = { notes: 0, received: 0, settling: 0, missing: 0 }
+  for (const business of config.businesses) {
+    const folder = businessFolder(config, business)
+    let paths: string[]
+    try { paths = await listFiles(folder, '.md') } catch (error) {
+      if ((error as NodeJS.ErrnoException).code === 'ENOENT') { round.missing += 1; continue }
+      throw error
+    }
+    for (const path of paths) {
+      if (signal?.aborted) throw new Error('The inbox Source stopped during the read')
+      const file = join(folder, path)
+      const info = await stat(file).catch(() => undefined)
+      if (!info) continue
+      round.notes += 1
+      const seen = KV.inbox.seen(file), fingerprint = `${info.mtimeMs}:${info.size}`
+      if (ctx.state.get(seen) === fingerprint) continue
+      if (now - info.mtimeMs < config.settleSeconds * 1000) { round.settling += 1; continue }
+      const note = parseNote(await readFile(file, 'utf8'))
+      if (!yes(note.head.draft)) {
+        const triggers = noteTriggers(note, { business, file, path, changed: info.mtimeMs }, config)
+        for (const trigger of triggers) if (await ctx.receive(trigger) === 'stored') round.received += 1
+        const thread = triggers[0]?.threads[0]
+        if (thread) {
+          const type = note.head.type || business.type
+          ctx.threads.describe(threadKey(thread), { label: String(triggers[0]!.meta.title), url: fileUrl(file), facts: {
+            business: { label: { zh: '业务', en: 'Business' }, value: business.title || business.id },
+            type: type ? { label: { zh: '类型', en: 'Type' }, value: type } : null,
+            status: yes(note.head.done) || /^(done|closed|完成|已完成)$/i.test(note.head.status ?? '') ? { label: { zh: '笔记', en: 'Note' }, value: { zh: '已标记完成', en: 'Marked done' } } : null,
+          } })
+        }
+      }
+      ctx.state.set(seen, fingerprint)
+    }
+  }
+  return round
+}
