new file mode 100644
index 0000000..e7ab083
--- /dev/null
+++ b/src/sources/inbox-note.ts
@@ -0,0 +1,69 @@
+/**
+ * The text of an inbox note: a front matter of `key: value` lines, then passages a person writes, between the agent's replies.
+ * A reply is a callout that starts with `> [!agent]` and carries a hidden `<!-- hq:<id> -->` marker, so a retried send finds it.
+ */
+import { localStamp } from './local-files.ts'
+/** One part of a note in document order: a passage a person wrote (`index` counts passages), or one of the agent's replies. */
+export interface NoteBlock { kind: 'person' | 'agent'; text: string; index: number; id?: string }
+export interface Note { head: Record<string, string>; blocks: NoteBlock[] }
+const AGENT = /^>\s*\[!agent\]/i
+const MARKER = /<!--\s*hq:([A-Za-z0-9_-]+)\s*-->/
+/** The marker a reply carries; a note that holds it has received that reply. */
+export const replyMarker = (id: string): string => `<!-- hq:${id} -->`
+const unquote = (value: string): string => /^(['"]).*\1$/.test(value) ? value.slice(1, -1) : value
+/** True for a front matter value that switches something on, such as `draft: true`. */
+export const yes = (value: string | undefined): boolean => /^(true|yes|on|1|是)$/i.test(value?.trim() ?? '')
+/** Splits a note into its front matter and its blocks. A passage without a letter or a digit, such as a rule (`---`), is no passage. */
+export function parseNote(source: string): Note {
+  let body = source.replace(/\r\n?/g, '\n').replace(/^\uFEFF/, '')
+  const head: Record<string, string> = {}
+  const front = /^---\n([\s\S]*?)\n---[ \t]*(?:\n|$)/.exec(body)
+  if (front) {
+    for (const line of front[1]!.split('\n')) {
+      const field = /^([A-Za-z][A-Za-z0-9_-]*):\s*(.*)$/.exec(line)
+      if (field) head[field[1]!.toLowerCase()] = unquote(field[2]!.trim())
+    }
+    body = body.slice(front[0].length)
+  }
+  const blocks: NoteBlock[] = []
+  let person: string[] = [], agent: string[] | undefined, passages = 0
+  const flushPerson = (): void => {
+    const text = person.join('\n').trim()
+    person = []
+    if (/[\p{L}\p{N}]/u.test(text)) blocks.push({ kind: 'person', text, index: passages++ })
+  }
+  const flushAgent = (): void => {
+    if (!agent) return
+    const raw = agent.map(line => line.replace(/^>\s?/, '')).join('\n')
+    const id = MARKER.exec(raw)?.[1]
+    blocks.push({ kind: 'agent', text: raw.replace(MARKER, '').trim(), index: blocks.length, ...id ? { id } : {} })
+    agent = undefined
+  }
+  for (const line of body.split('\n')) {
+    if (agent) {
+      if (line.startsWith('>')) { agent.push(line); continue }
+      flushAgent()
+    }
+    if (AGENT.test(line)) { flushPerson(); agent = [line]; continue }
+    person.push(line)
+  }
+  flushAgent(); flushPerson()
+  return { head, blocks }
+}
+/** The title of a note: its front matter `title`, else the first heading of its first passage, else `fallback`. */
+export function noteTitle(note: Note, fallback: string): string {
+  const first = note.blocks.find(block => block.kind === 'person')?.text ?? ''
+  return note.head.title || /^#{1,6}\s+(.+)$/m.exec(first)?.[1]?.trim() || fallback
+}
+/**
+ * A reply as a callout to append to a note, with a blank line before and after it, so the next passage a person writes
+ * starts outside it.
+ */
+export function replyBlock(id: string, title: string, at: Date, text: string): string {
+  const lines = text.trim().split('\n').map(line => line.trim() ? `> ${line}` : '>')
+  return ['', `> [!agent] ${title} · ${localStamp(at)}`, ...lines, `> ${replyMarker(id)}`, '', ''].join('\n')
+}
+/** Titles of replies by the kind of message an Outbox sends. */
+export const REPLY_TITLES: Readonly<Record<'acknowledgement' | 'reply' | 'notice', string>> = {
+  acknowledgement: '已接单', reply: '回复', notice: '通知',
+}
diff --git a/src/sources/inbox.ts b/src/sources/inbox.ts
