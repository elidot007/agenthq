+/**
+ * Spool Source kind and plugin entry, exported as `./spool-watch`: a local drop folder through which other programs, such as
+ * an automation, a chat bot or a monitor, hand the agent requests as JSON files, and read its replies as JSON files.
+ */
+import type { Context } from '@deepseek-ai/cordis'
+import { mkdir, readdir, writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { z } from 'zod'
+import { key, threadKey, type OutboundMessage, type Trigger } from '../core/index.ts'
+import { health, sourceContext, type SourceContext } from './host.ts'
+import type { SourceKind } from './kind.ts'
+import { fileUrl, inside, moveInto, readJson } from './local-files.ts'
+import { pause } from './poll.ts'
+export const SPOOL = 'spool'
+const Slug = z.string().regex(/^[a-z0-9][a-z0-9-]{0,39}$/)
+const absolute = z.string().trim().regex(/^(\/.*)?$/, 'An absolute path')
+const SenderSchema = z.object({
+  id: Slug,
+  /** `person` for a program that relays what a person asked, whose messages may be explicit requests; `bot` for one acting on its own. */
+  kind: z.enum(['person', 'bot']).default('bot'),
+  business: z.string().trim().regex(/^([a-z0-9][a-z0-9-]*)?$/).default(''),
+}).strict()
+const SpoolConfigSchema = z.object({
+  inDir: absolute.default(''),
+  outDir: absolute.default(''),
+  senders: z.array(SenderSchema).default([]),
+  pollSeconds: z.number().int().min(2).max(600).default(5),
+}).strict()
+export type SpoolConfig = z.infer<typeof SpoolConfigSchema>
+export type SpoolSender = SpoolConfig['senders'][number]
+const Id = z.string().regex(/^[A-Za-z0-9_.:-]{1,80}$/)
+/** One request file as a program writes it. */
+export const SpoolMessageSchema = z.looseObject({
+  id: Id,
+  sender: z.string().regex(/^[a-z0-9][a-z0-9-]{0,39}$/),
+  conversation: z.string().regex(/^[A-Za-z0-9_.-]{1,80}$/).default('default'),
+  thread: Id.optional(),
+  text: z.string().trim().min(1).max(20000),
+  business: z.string().regex(/^([a-z0-9][a-z0-9-]*)?$/).optional(),
+  type: z.string().regex(/^([a-z0-9-]{1,30})?$/).optional(),
+  repo: z.string().regex(/^(\/.*)?$/).optional(),
+  at: z.iso.datetime({ offset: true }).optional(),
+  addressed: z.boolean().default(true),
+  url: z.string().url().optional(),
+})
+export type SpoolMessage = z.infer<typeof SpoolMessageSchema>
+/** A request file as a Trigger. Its Thread is the conversation and the message that began the exchange, so later messages naming it follow up. */
+export function spoolTrigger(message: SpoolMessage, sender: Pick<SpoolSender, 'kind' | 'business'>, outDir: string, now: Date): Trigger {
+  const root = message.thread ?? message.id
+  const thread = { source: SPOOL, id: `${message.conversation}/${root}` }
+  const person = sender.kind === 'person'
+  const business = message.business ?? sender.business
+  return {
+    id: key(SPOOL, message.sender, message.id), source: SPOOL, threads: [thread],
+    actor: { source: SPOOL, id: message.sender }, human: person,
+    ...message.addressed ? { addressed: person ? 'direct' as const : 'mention' as const } : {},
+    at: message.at ?? now.toISOString(), text: message.text,
+    channel: { source: SPOOL, thread: threadKey(thread), address: { conversation: message.conversation, root, message: message.id, sender: message.sender,
+      ...outDir ? { dir: join(outDir, message.conversation) } : {} } },
+    ...message.url ? { url: message.url } : {},
+    meta: { conversation: message.conversation, sender: message.sender, root, messageId: message.id, ...business ? { business } : {},
+      ...message.type ? { type: message.type } : {}, ...message.repo ? { repo: message.repo } : {} },
+  }
+}
+/** Writes a reply as `<outDir>/<conversation>/<message id>.json`, once; the program on the other side reads and removes it. */
+export async function sendSpool(_host: unknown, message: OutboundMessage, now = new Date()): Promise<'sent' | 'gone'> {
+  const { conversation, root, message: replyTo, dir } = message.channel.address
+  // A request received while no reply folder was set has nowhere to be answered.
+  if (!dir) return 'gone'
+  await mkdir(dir, { recursive: true })
+  const body = JSON.stringify({ id: message.id, kind: message.kind, conversation, thread: root, replyTo, ticket: message.ticketId ?? null,
+    text: message.text, at: now.toISOString() }, null, 2)
+  await writeFile(join(dir, `${message.id}.json`), `${body}\n`, { flag: 'wx' }).catch((error: unknown) => {
+    if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error
+  })
+  return 'sent'
+}
+export const spoolKind: SourceKind<SpoolConfig> = {
+    kind: SPOOL,
+    title: { zh: '投递目录', en: 'Spool' },
+    description: { zh: '本机程序把请求写成 JSON 文件放进收取目录，回复以 JSON 文件写进回复目录；发送者要在名单上。', en: 'Local programs drop requests as JSON files into the incoming folder and read replies as JSON files from the reply folder; senders must be listed.' },
+    schema: SpoolConfigSchema,
+    fields: [
+      { key: 'inDir', type: 'text', label: { zh: '收取目录', en: 'Incoming folder' }, hint: { zh: '绝对路径。读过的文件移进 .done，读不了的移进 .bad。', en: 'An absolute path. Read files move into .done, unreadable ones into .bad.' } },
+      { key: 'outDir', type: 'text', label: { zh: '回复目录', en: 'Reply folder' }, hint: { zh: '绝对路径。回复写成 <对话>/<消息 id>.json。', en: 'An absolute path. Replies are written as <conversation>/<message id>.json.' } },
+      { key: 'senders', type: 'rows', label: { zh: '发送者', en: 'Senders' }, columns: [
+        { key: 'id', type: 'text', label: { zh: '发送者 id', en: 'Sender id' }, pattern: '[a-z0-9][a-z0-9\\-]*' },
+        { key: 'kind', type: 'select', label: { zh: '代表', en: 'Acts for' }, options: [
+          { value: 'person', label: { zh: '转达人的请求', en: 'Relays a person' } }, { value: 'bot', label: { zh: '程序自己', en: 'Itself' } }] },
+        { key: 'business', type: 'text', label: { zh: '默认业务', en: 'Default business' }, optional: true }] },
+      { key: 'pollSeconds', type: 'number', advanced: true, min: 2, max: 600, label: { zh: '轮询间隔 / 秒', en: 'Polling interval / seconds' } }],
+    health: [SPOOL],
+    scope: ({ meta }, config) => {
+      const sender = config.senders.find(item => item.id === meta.sender)
+      return sender ? { listened: true, observed: true, row: sender.id } : { listened: false, reason: 'sender_not_listed' }
+    },
+    channel: {
+      allowed: (address, config) => config.senders.some(item => item.id === address.sender) && (!address.dir || inside(config.outDir, address.dir)),
+      send: (host, message) => sendSpool(host, message),
+      link: address => ({ url: fileUrl(address.dir ?? ''),
+        label: { zh: `投递目录对话 ${address.conversation ?? ''}`.trim(), en: `Spool conversation ${address.conversation ?? ''}`.trim() } }),
+    },
+    find: query => ({ threads: /^spool:\S+$/.test(query.trim()) ? [query.trim()] : [], terms: [] }),
+    policy: {
+      schema: z.object({
+        allowed: z.array(z.object({ id: z.string().regex(/^[a-z0-9][a-z0-9-]*$/), name: z.string().trim().max(100).optional() }).strict()).default([]),
+        bots: z.array(z.object({ id: z.string().regex(/^[a-z0-9][a-z0-9-]*$/) }).strict()).optional(),
+      }).strict(),
+      fields: [
+        { key: 'allowed', type: 'rows', label: { zh: '能发起工作的发送者', en: 'Senders who may originate work' },
+          hint: { zh: '只对“转达人的请求”的发送者有效。', en: 'Applies to senders that relay a person.' },
+          columns: [{ key: 'id', type: 'text', label: { zh: '发送者 id', en: 'Sender id' } }, { key: 'name', type: 'text', label: { zh: '名字', en: 'Name' }, optional: true }] },
+        { key: 'bots', type: 'rows', label: { zh: '消息可以成为候选的程序', en: 'Programs whose messages may become candidates' },
+          hint: { zh: '“程序自己”的发送者在名单上时，它的消息成为推断的候选，按规则评估；它不能发起明确的请求。', en: 'A sender acting for itself on this list produces inferred candidates, assessed by the rules; it never makes an explicit request.' },
+          columns: [{ key: 'id', type: 'text', label: { zh: '发送者 id', en: 'Sender id' } }] }],
+      explicit: { zh: '名单里转达人的请求的发送者，消息里 addressed 为 true（默认）。', en: 'A listed sender that relays a person sends a message with addressed true, the default.' },
+      rows: stored => {
+        const config = SpoolConfigSchema.safeParse(stored)
+        return (config.success ? config.data.senders : []).map(sender => ({ id: sender.id, label: sender.id,
+          note: sender.kind === 'person' ? { zh: '转达人的请求', en: 'Relays a person' } : { zh: '程序自己', en: 'Itself' },
+          cells: { listedUnaddressed: true, unlistedAddressed: true, unlistedUnaddressed: true } }))
+      },
+    },
+    environment: {
+      variables: [
+        { key: 'DSH_SUPERAGENT_SPOOL_SENDER', description: { zh: '接下工单的投递目录发送者；工单不是从投递目录来的时为空', en: 'The spool sender that started the ticket; empty when it did not start in the spool' } },
+        { key: 'DSH_SUPERAGENT_SPOOL_CONVERSATION', description: { zh: '接下工单的投递目录对话', en: 'The spool conversation that started the ticket' } },
+        { key: 'DSH_SUPERAGENT_SPOOL_BUSINESS', description: { zh: '请求或发送者写明的业务 id；没写时为空', en: 'The business the request or its sender names; empty when none is named' } },
+        { key: 'DSH_SUPERAGENT_SPOOL_TYPE', description: { zh: '请求写明的工作类型；没写时为空', en: 'The kind of work the request names; empty when none is named' } },
+        { key: 'DSH_SUPERAGENT_SPOOL_REPO', description: { zh: '请求写明的本地仓库绝对路径；没写时为空', en: 'Absolute path of the local repository the request names; empty when none is named' } },
+      ],
+      values: ({ trigger }) => {
+        const text = (name: string): string => trigger?.source === SPOOL && typeof trigger.meta[name] === 'string' ? trigger.meta[name] : ''
+        return { DSH_SUPERAGENT_SPOOL_SENDER: text('sender'), DSH_SUPERAGENT_SPOOL_CONVERSATION: text('conversation'), DSH_SUPERAGENT_SPOOL_BUSINESS: text('business'),
+          DSH_SUPERAGENT_SPOOL_TYPE: text('type'), DSH_SUPERAGENT_SPOOL_REPO: text('repo') }
+      },
+    },
+}
+export const name = 'dsh-superagent-spool'
+export const inject = ['orchestrator']
+export function apply(ctx: Context): void {
+  ctx.effect(() => ctx.orchestrator.sources.register(spoolKind), 'spool: source kind')
+  ctx.effect(() => {
+    const source = sourceContext(ctx.orchestrator, spoolKind)
+    const controller = new AbortController()
+    // Unhandled rejections terminate the DSH process, so a failure escaping the polling loop is reported as source health instead.
+    const running = watch(source, controller.signal)
+      .catch((error: unknown) => { source.report(SPOOL, { state: 'error', detail: String(error) }) })
+    return async () => { controller.abort(); await running }
+  })
+}
+async function watch(ctx: SourceContext, signal: AbortSignal): Promise<void> {
+  await ctx.ready
+  if (!ctx.configured()) { ctx.report(SPOOL, health('paused', 'setupPending')); return }
+  let failures = 0
+  while (!signal.aborted) {
+    const config = ctx.config<SpoolConfig>(SPOOL)
+    const at = new Date()
+    if (!config) ctx.report(SPOOL, health('paused', 'sourceOff'))
+    else if (!config.inDir) ctx.report(SPOOL, { state: 'paused', detail: 'No incoming folder is set', at: at.toISOString() })
+    else {
+      try {
+        const round = await readSpool(ctx, config, at)
+        failures = 0
+        ctx.report(SPOOL, { state: 'ready', at: at.toISOString(), detail: `${round.received} requests read${round.unreadable ? `, ${round.unreadable} unreadable` : ''}` })
+      } catch (error) {
+        failures += 1
+        if (!signal.aborted && failures >= 3) ctx.report(SPOOL, health('error', 'pollFailures', { count: String(failures), error: String(error) }))
+      }
+    }
+    await pause((config?.pollSeconds ?? 5) * 1000, signal)
+  }
+}
+/** Hands each request file to the Engine, then moves it into `.done`; a file that is not a request moves into `.bad`. */
+export async function readSpool(ctx: SourceContext, config: SpoolConfig, now: Date): Promise<{ received: number; unreadable: number }> {
+  const round = { received: 0, unreadable: 0 }
+  const names = await readdir(config.inDir).catch((error: unknown) => {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return []
+    throw error
+  })
+  for (const name of names.filter(item => item.endsWith('.json') && !item.startsWith('.')).sort()) {
+    const file = join(config.inDir, name)
+    const parsed = SpoolMessageSchema.safeParse(await readJson(file))
+    if (!parsed.success) { round.unreadable += 1; await moveInto(file, join(config.inDir, '.bad')); continue }
+    const sender = config.senders.find(item => item.id === parsed.data.sender) ?? { kind: 'bot' as const, business: '' }
+    // An unlisted sender's request is still received, so the panel shows it as filtered with the reason.
+    if (await ctx.receive(spoolTrigger(parsed.data, sender, config.outDir, now)) === 'stored') round.received += 1
+    await moveInto(file, join(config.inDir, '.done'))
+  }
+  return round
+}
