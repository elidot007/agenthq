+    expect(inboxKind.environment!.values({ deployment: undefined as never, config: h.config })).toMatchObject({ DSH_SUPERAGENT_INBOX_NOTE: '' })
+  })
+})
+describe('inbox replies', () => {
+  const message = (file: string, id = 'r1'): OutboundMessage => ({ id, kind: 'reply', text: '结果在 outputs/report.md。', ticketId: 't1',
